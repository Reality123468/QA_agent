# ============================================
# QA Agent Docker 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================

# --- MySQL 数据库 ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=qa_agent
DB_USERNAME=root
DB_PASSWORD=admin123456
MYSQL_ROOT_PASSWORD=admin123456

# --- JWT ---
JWT_SECRET=change-me-to-a-random-256-bit-secret-key
JWT_EXPIRATION=86400000

# --- 内部 Agent API ---
AGENT_API_KEY=change-me-to-an-internal-api-key
AGENT_BASE_URL=http://python-agent:8000

# --- DeepSeek AI ---
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com

# --- MinIO 对象存储 ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123456
MINIO_BUCKET=qa-documents

# --- Qdrant 向量数据库 ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- 服务端口 ---
AUTH_PORT=8080
DOCUMENT_PORT=8081
CHAT_PORT=8082
AUDIT_PORT=8083
PYTHON_PORT=8000
NGINX_PORT=80
